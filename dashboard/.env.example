# Trader configuration.
# 1. Copy this file to .env  (cp .env.example .env)
# 2. Pick a TRADING_MODE below.
#
# docker compose reads this dir's .env automatically and forwards these
# into the server container + trader subprocesses.

# ── Trading mode ────────────────────────────────────────────────────────────
# paper   — mainnet REAL market data, local virtual fills. No keys, no real
#           orders. This is the correct way to validate a strategy's win rate.
# testnet — Bybit sandbox. Real orders on FAKE order books (prices unrelated to
#           mainnet) — engineering/debug only, NOT for validating alpha.
# live    — mainnet, REAL orders. Requires keys. Use with care.
TRADING_MODE=paper

# ── Paper-mode knobs (only used when TRADING_MODE=paper) ────────────────────
PAPER_EQUITY=10000          # starting virtual USDT balance
PAPER_TAKER_FEE=0.00055     # Bybit USDT-perp taker fee fraction (0.055%)
PAPER_SLIPPAGE_BPS=5        # adverse slippage per fill, in basis points

# ── Kill switch (drawdown auto-pause / auto-terminate) ──────────────────────
# Drawdown from peak equity that pauses new orders / shuts the loop down.
# Defaults pause@5% / terminate@7%. A strategy whose expected drawdown exceeds
# 7% (e.g. eth_s5_half_size ≈ 9% OOS DD) WILL auto-terminate unless you raise
# KILL_TERMINATE_DD above its expected DD. On terminate the loop flips its
# control.json to stopped, so the manager won't respawn it.
KILL_PAUSE_DD=0.05
KILL_TERMINATE_DD=0.07

# ── Factor freshness ────────────────────────────────────────────────────────
# Pause trading when the factor store's newest bar is older than this many days
# (signal.py guard). Default 2 suits daily-archive factors. A freshness-sensitive
# strategy fed by an hourly live cron must tighten this BELOW its edge-decay
# crossover — e.g. sol_s1 (ls_divergence) decays below sharpe 1.0 at ~16-18h, so
# deploy it with FACTOR_MAX_AGE_DAYS=0.5 (12h): a dead cron then pauses before the
# edge is gone instead of trading 2 days of stale alpha.
FACTOR_MAX_AGE_DAYS=2

# Cron-health alert: warn when the factor store has not been REWRITTEN within this
# many hours (the refresh cron likely broke). Distinct from the data-age guard
# above; alert only, no trading change.
REFRESH_STALL_HOURS=30

# ── Credentials (required ONLY for testnet / live) ──────────────────────────
# testnet key: https://testnet.bybit.com → API Management
# live key:    https://www.bybit.com → API Management  (real funds — danger)
# .env is gitignored — never commit real keys.
BYBIT_API_KEY=
BYBIT_API_SECRET=
