# Bybit TESTNET credentials for paper trading.
# 1. Copy this file to .env  (cp .env.example .env)
# 2. Create a TESTNET key at https://testnet.bybit.com → API Management
#    (NOT mainnet — broker.py uses set_sandbox_mode(True))
# 3. Fill the values below. .env is gitignored — never commit real keys.
#
# docker compose reads this dir's .env automatically and forwards these
# into the server container + trader subprocesses.

BYBIT_API_KEY=
BYBIT_API_SECRET=
