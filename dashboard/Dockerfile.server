FROM python:3.11-slim

WORKDIR /app/server

COPY server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY server/ .

# trader/ package — launched as a subprocess by the supervisor (python -m trader.loop)
COPY trader/ /app/trader/

# Repo root is mounted at /repo at runtime
ENV REPO_ROOT=/repo

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
