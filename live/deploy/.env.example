# Bybit testnet API keys
# Get from: https://testnet.bybit.com → API Management → Create API Key
# Permissions needed: Contract → Orders & Positions (read + trade)
BYBIT_TESTNET_API_KEY=your_key_here
BYBIT_TESTNET_API_SECRET=your_secret_here

# Capital simulation (USDT) — paper trade uses this as cap, not actual testnet balance
LIVE_CAPITAL_USDT=1000

# Leverage (max enforced 3.0 by bybit_client safety)
LIVE_LEVERAGE=1.5

# Set to 1 to never send orders (signal + position log only)
LIVE_DRY_RUN=0

# OPT-OUT FOR MAINNET (DO NOT SET UNLESS YOU MEAN IT)
# BYBIT_LIVE=0
